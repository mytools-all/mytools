{
  "name": "mytools",
  "private": true,
  "version": "0.1.0",
  "description": "Lightweight plugin toolbox built with Tauri",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "pwsh -NoProfile -File scripts/start-cdp.ps1",
    "test:debug": "node --test scripts/cdp-endpoint.test.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dev:install": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-install.ps1",
    "dev:install:debug": "pwsh -NoProfile -File scripts/dev-install.ps1 -Cdp",
    "dev:install:clean": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-install.ps1 -Mode Clean",
    "dev:install:skip": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-install.ps1 -Mode Skip",
    "type-check": "vue-tsc --noEmit",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "lint:frontend": "eslint src",
    "lint:backend": "cd src-tauri && cargo clippy --workspace --all-targets -- -D warnings",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:backend": "cd src-tauri && cargo llvm-cov --workspace --text --summary-only --fail-under-lines 50",
    "test:e2e": "wdio run e2e/wdio.conf.ts",
    "test:e2e:driver": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-driver.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@vueuse/core": "^12.5.0",
    "markdown-it": "^15.0.3",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^15.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.16",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5",
    "webdriverio": "^9.32.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mytools-all/mytools.git"
  }
}
